# IP-Adresse des Serial-Servers im Netzwerk (Pflicht)
SERIAL_HOST=192.168.1.XXX

# UID/GID des Host-Users, dem ./data gehoert (fuer Bind-Mount-Schreibrechte).
# Mit "id <user>" auf dem Host ermitteln.
PUID=1000
PGID=1000

# TCP-Port des Serial-Servers (Standard: 10001 für ersten Port)
SERIAL_PORT=10001

# MQTT-Broker – "localhost" wenn Mosquitto auf demselben Host läuft
# Bei network_mode: host kann "localhost" oder die Host-IP verwendet werden
MQTT_HOST=localhost
MQTT_PORT=1883

# MQTT-Zugangsdaten (leer lassen wenn kein Login nötig)
MQTT_USER=
MQTT_PASSWORD=

# Abfrageintervall in Sekunden (Standard: 60)
POLL_INTERVAL=60

# MQTT-Topic-Prefix (Standard: hlc20)
DEVICE_TOPIC=hlc20

# Home Assistant MQTT Auto-Discovery Prefix (Standard: homeassistant)
DISCOVERY_PREFIX=homeassistant
